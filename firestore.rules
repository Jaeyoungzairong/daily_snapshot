rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // [email]의 세션(로그인)이 아직 유효한지 — "다른 모든 기기에서 로그아웃" 기능이 갱신하는
    // admin_allowed_emails.forceLogoutAfter 이후에 실제로 로그인한(auth_time) 세션만 통과.
    // 필드가 없으면(한 번도 강제 로그아웃을 실행한 적 없으면) 항상 통과 — 마이그레이션이나
    // 기본값 채우기가 필요 없도록 "없음 = 제한 없음"을 기본 상태로 둔다.
    function isSessionFresh(email) {
      let record = get(/databases/$(database)/documents/admin_allowed_emails/$(email)).data;
      // 점(.) 표기로 없는 필드에 바로 접근하면 규칙 평가 자체가 에러로 실패할 수 있어
      // (Firestore가 이런 경우를 위해 별도로 안전 접근용 get(key, 기본값)을 제공하는 이유),
      // map.get()으로 필드가 없을 때의 기본값(null)을 명시적으로 지정한다.
      let forceLogoutAfter = record.get('forceLogoutAfter', null);
      return forceLogoutAfter == null
        || request.auth.token.auth_time > forceLogoutAfter.toMillis() / 1000;
    }

    // 로그인 승인 명단. 이메일 하나당 문서 하나(문서 ID = 이메일, 소문자로 통일)이고
    // isActive(boolean) 필드로 활성 여부를 나타낸다 — 관리자가 문서를 지우지 않고도
    // false로 바꿔 접근을 잠깐 정지시켰다가 다시 true로 되돌릴 수 있다. get(단건 조회)은
    // 누구나(로그인 전에도) 허용해서, 로그인 링크 발송 전에 승인 여부를 미리 확인할 수
    // 있게 한다. list(전체 목록 조회)는 막아서, 승인된 이메일 전체 목록이 노출되지
    // 않게 한다. 관리자(jychoi@bsptech.co.kr)만 수정할 수 있다.
    match /admin_allowed_emails/{email} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null && request.auth.token.email == 'jychoi@bsptech.co.kr';

      // 본인 계정의 forceLogoutAfter 필드만, 본인 세션이 유효한 동안 스스로 갱신할 수 있다
      // — "다른 모든 기기에서 로그아웃"은 관리자 승인 없이 누구나 자기 계정에 실행 가능해야
      // 한다. isSessionFresh를 같이 걸어서, 이미 강제 로그아웃된(오래된) 세션이 이 필드를
      // 되돌려 스스로 복구하는 것은 막는다.
      allow update: if request.auth != null
        && request.auth.token.email == email
        && isSessionFresh(email)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['forceLogoutAfter']);
    }

    // 각 사용자(uid)는 자기 자신의 데이터만 읽고 쓸 수 있다. 이메일이 인증됐고
    // 승인 명단(admin_allowed_emails)에서 isActive가 true이고 세션이 아직 유효한 경우에만
    // 허용한다.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/admin_allowed_emails/$(request.auth.token.email)).data.isActive == true
        && isSessionFresh(request.auth.token.email);
    }

    // 공유 파일함 메타데이터. uid로 나뉘지 않고, 승인된 사용자 전원이 읽고(목록 조회)
    // 새로 만들 수 있다(업로드). 삭제는 admin_allowed_emails 문서에 isAdmin:true가 있는
    // 사용자 전체 또는 본인이 올린 파일(uploadedByEmail 일치)만 — 이메일을 규칙에 다시
    // 하드코딩하지 않고 이미 있는 승인 문서의 필드 하나로 판단해서, 나중에 관리자를
    // 바꿀 때도 콘솔에서 필드만 고치면 되게 한다.
    match /shared_files/{fileId} {
      allow read, create: if request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/admin_allowed_emails/$(request.auth.token.email)).data.isActive == true
        && isSessionFresh(request.auth.token.email);
      allow delete: if request.auth != null && isSessionFresh(request.auth.token.email) && (
        get(/databases/$(database)/documents/admin_allowed_emails/$(request.auth.token.email)).data.isAdmin == true
        || resource.data.uploadedByEmail == request.auth.token.email
      );
    }
  }
}
