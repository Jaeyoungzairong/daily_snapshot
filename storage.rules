rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 공유 파일함 실 파일. Firestore의 admin_allowed_emails 문서를 그대로 교차 조회해서
    // Firestore 규칙(firestore.rules)과 같은 조건을 유지한다 — 승인된 사용자 전원이
    // 읽고(다운로드) 100MB 이하로 새로 올릴 수 있고(업로드), 삭제는 isAdmin:true인
    // 사용자만 할 수 있다.
    match /shared_files/{fileId}/{fileName} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/admin_allowed_emails/$(request.auth.token.email)).data.isActive == true;

      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/admin_allowed_emails/$(request.auth.token.email)).data.isActive == true
        && request.resource.size < 100 * 1024 * 1024;

      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/admin_allowed_emails/$(request.auth.token.email)).data.isAdmin == true;
    }
  }
}
