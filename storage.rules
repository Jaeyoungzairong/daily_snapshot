rules_version = '2';

service firebase.storage {
  // [email]의 세션(로그인)이 아직 유효한지 — firestore.rules의 isSessionFresh와 동일한
  // 조건을 Storage 쪽에서도 그대로 적용한다. "다른 모든 기기에서 로그아웃" 기능이 갱신하는
  // admin_allowed_emails.forceLogoutAfter 이후에 실제로 로그인한(auth_time) 세션만 통과.
  function isSessionFresh(email) {
    let record = firestore.get(/databases/(default)/documents/admin_allowed_emails/$(email)).data;
    // 점(.) 표기로 없는 필드에 바로 접근하면 규칙 평가 자체가 에러로 실패할 수 있어,
    // map.get()으로 필드가 없을 때의 기본값(null)을 명시적으로 지정한다.
    let forceLogoutAfter = record.get('forceLogoutAfter', null);
    return forceLogoutAfter == null
      || request.auth.token.auth_time > forceLogoutAfter.toMillis() / 1000;
  }

  match /b/{bucket}/o {
    // 공유 파일함 실 파일. Firestore의 admin_allowed_emails 문서를 그대로 교차 조회해서
    // Firestore 규칙(firestore.rules)과 같은 조건을 유지한다 — 승인된 사용자 전원이
    // 읽고(다운로드) 150MB 이하로 새로 올릴 수 있고(업로드), 삭제는 isAdmin:true인
    // 사용자 전체 또는 본인이 올린 파일만 할 수 있다. Storage 객체 자체엔 업로더 정보가
    // 없어서, shared_files/{fileId} Firestore 문서를 교차 조회해 uploadedByEmail을
    // 비교한다 — deleteFile()이 Storage를 먼저 지우고 Firestore 문서를 나중에 지우므로
    // (file_repository.dart) 이 시점엔 문서가 항상 남아있다.
    match /shared_files/{fileId}/{fileName} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/admin_allowed_emails/$(request.auth.token.email)).data.isActive == true
        && isSessionFresh(request.auth.token.email);

      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/admin_allowed_emails/$(request.auth.token.email)).data.isActive == true
        && isSessionFresh(request.auth.token.email)
        && request.resource.size <= 150 * 1024 * 1024;

      allow delete: if request.auth != null && isSessionFresh(request.auth.token.email) && (
        firestore.get(/databases/(default)/documents/admin_allowed_emails/$(request.auth.token.email)).data.isAdmin == true
        || firestore.get(/databases/(default)/documents/shared_files/$(fileId)).data.uploadedByEmail == request.auth.token.email
      );
    }
  }
}
